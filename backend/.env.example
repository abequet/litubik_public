# Copy to .env and fill in. LITUBIK_SECRET_KEY signs JWTs and encrypts stored API keys:
# generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LITUBIK_SECRET_KEY=change-me
# LITUBIK_DATA_DIR=../data
# LITUBIK_DATABASE_URL=sqlite:///../data/litubik.db
# LITUBIK_ACCESS_TOKEN_EXPIRE_MINUTES=720
# Signup policy. false (the default) = RESTRICTED, not closed: the first account
# of a fresh instance, an allowlisted email, anyone a project admin already added
# to a team, and open project invitations can still register — everyone else is
# refused. Set to true only for free signup on a trusted LAN.
# LITUBIK_ALLOW_REGISTRATION=false
# Comma-separated allowlist, provisioned at boot. Lets these emails register
# under the restricted policy (and, on a demo instance, as full accounts).
# LITUBIK_TRUSTED_EMAILS=you@your-institution.example
# Contact address sent to Crossref / OpenAlex (polite pool) and NCBI E-utilities.
# Unset: the global Unpaywall e-mail is used if one is set, otherwise no address.
# LITUBIK_CONTACT_EMAIL=team@your-lab.example
# Public demo instance (docs/DEPLOYMENT.md). Visitors open a one-click guest
# session on the host names of LITUBIK_DEMO_GUEST_HOSTS; e-mail registration is
# then for the allowlist only (LITUBIK_ALLOW_REGISTRATION is ignored).
# LITUBIK_DEMO=true
# LITUBIK_DEMO_RESET_HOUR=4
# LITUBIK_DEMO_GUEST_HOSTS=demo.*
# What visitors may spend on the app-wide AI key (USD): per guest session, and
# for all of them per UTC day and per calendar month. 0 turns AI off for them.
# LITUBIK_DEMO_AI_USER_CAP_USD=2
# LITUBIK_DEMO_AI_DAILY_CAP_USD=1
# LITUBIK_DEMO_AI_MONTHLY_CAP_USD=10
