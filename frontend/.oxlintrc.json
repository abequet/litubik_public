{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Accessibility (roadmap 17a, WCAG 2.1 AA). The jsx-a11y plugin runs with
    // the options of eslint-plugin-jsx-a11y's "recommended" preset, plus two
    // deliberate relaxations:
    // - no-autofocus: every autoFocus in the app is inside a dialog or an
    //   inline editor the user has just opened, where moving focus is the
    //   expected behaviour (WAI-ARIA dialog pattern), not a page-load jump;
    // - prefer-tag-over-role: it rejects `<svg role="img">`, which is the
    //   correct way to expose a chart to assistive technology.
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-static-element-interactions": ["error", {
      "handlers": ["onClick", "onMouseDown", "onMouseUp", "onKeyPress", "onKeyDown", "onKeyUp"]
    }],
    "jsx-a11y/no-noninteractive-element-interactions": ["error", {
      "handlers": ["onClick", "onError", "onLoad", "onMouseDown", "onMouseUp", "onKeyPress", "onKeyDown", "onKeyUp"]
    }]
  }
}
